import pandas as pd
from sklearn.linear_model import LinearRegression
import pickle

# Load dataset
df = pd.read_csv("Placement.csv")

# Features and target
X = df[['cgpa']]
y = df['package']

# Train model
model = LinearRegression()
model.fit(X, y)

# Save trained model
pickle.dump(model, open("SLRModel.pkl", "wb"))

print("SLRModel.pkl created successfully!")